{
 "format": 1,
 "command": "./handling",
 "verbs": {
  "open": ["url"],
  "look": [],
  "read": [],
  "back": [],
  "done": [],
  "click": ["number"],
  "type": ["number", "text"],
  "select": ["number", "text"],
  "scroll": ["direction"]
 },
 "patterns": {
  "number": "^[0-9]{1,3}$",
  "direction": "^(down|up)$",
  "url": "^https?://[A-Za-z0-9.-]+(:[0-9]{2,5})?(/[A-Za-z0-9._/-]*)?$",
  "text": "^[A-Za-z0-9À-ÖØ-öø-ÿ .,:%+=/@_–—-]{1,500}$",
  "forbidden": "[;&|`$<>\\\\\n\r\t*?\\[\\]{}~!#\"'()]"
 },
 "page": {
  "denied_prefixes": ["/api", "/_next", "/_vercel"],
  "allowed_suffixes": ["", ".html", ".htm"]
 },
 "max_arguments": 260,
 "max_argument_chars": 600
}
